# Шаблон клиента AmneziaWG. Берите конфиг из панели 3x-ui
# и меняйте в нём только DNS, MTU и AllowedIPs.

[Interface]
PrivateKey = <ключ клиента из панели>
Address = 10.0.0.2/32
DNS = 1.1.1.1, 8.8.8.8
MTU = 1280
# Ниже значения из панели, без изменений:
Jc = ...
Jmin = ...
Jmax = ...
S1 = ...
S2 = ...
S3 = ...
S4 = ...
H1 = ...
H2 = ...
H3 = ...
H4 = ...
# I1–I5, если панель их выдала

[Peer]
PublicKey = <публичный ключ сервера>
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint = <IP_сервера>:<порт_AWG>
PersistentKeepalive = 25
